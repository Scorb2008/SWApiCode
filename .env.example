BOT_TOKEN=
ADMIN_IDS=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

DATABASE_URL=sqlite+aiosqlite:///data/bot.db
PUBLIC_URL=https://your-domain.com

PURCHASE_MAX_QUANTITY=10

# Support button — @username, numeric Telegram ID, or email
SUPPORT_CONTACT=

# Telegram channel link (e.g. https://t.me/your_channel)
CHANNEL_URL=

# Legal documents (defaults to Telegraph pages if empty)
PRIVACY_POLICY_URL=
USER_AGREEMENT_URL=

# FunPay integration
# Golden key from FunPay profile → "Разработчикам"
FUNPAY_GOLDEN_KEY=
# JSON mapping: FunPay lot description keywords → bot account size names
# The system checks if a keyword is found in the order description
# Example: {"CODEX 30":"30МЛН","CODEX 100":"100МЛН","CODEX 300":"300МЛН"}
FUNPAY_LOT_MAPPING=
# FunPay lot ID (optional, used as fallback if FUNPAY_LOT_MAPPING fails)
FUNPAY_LOT_ID=0
